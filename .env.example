PORT=5000
NODE_ENV=production
# Required: preserve the SAME value from your previous deployment.
JWT_SECRET=
# Required: published Lovable Cloud service origin, without a trailing path.
NOCHAT_CLOUD_URL=
# Required: copy from the secure form into Render (never into Git or chat).
NOCHAT_BRIDGE_SECRET=
# Required to sign into the existing official Denpher account if it has no password.
FOUNDER_PASSWORD=
# Optional: the founder's email. Video management additionally requires the stored founder email to match
# the built-in founder fingerprint, so setting a different address here can never grant video management.
FOUNDER_EMAIL=
# Daily per-user successful upload count, resets at 00:00 UTC; deleting does not restore quota.
DAILY_REEL_LIMIT=2
# Videos: one view per viewer per video within this window (minutes).
VIDEO_VIEW_WINDOW_MINUTES=30

# ---------- Calls: STUN + TURN (see TURN-SETUP.md) ----------
# STUN (comma separated). Default: Google public STUN.
STUN_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Option A (recommended, self-hosted coturn with use-auth-secret): short-lived HMAC credentials.
TURN_SECRET=
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_TTL_SECONDS=3600
# Option B: Cloudflare Realtime TURN (temporary credentials generated per call).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option C: Metered.ca TURN (credentials fetched server-side with your API key).
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
# Legacy static credential (works, but is long-lived and reported as "static").
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Testing only: force every call through TURN to prove the relay works.
TURN_FORCE_RELAY=false

# Optional explicit allowed origins; normally keep app same-origin on Render.
CORS_ORIGIN=
COOKIE_SECURE=
# Local development ONLY; production uploads and records never use these folders.
DATA_DIR=
UPLOADS_DIR=
